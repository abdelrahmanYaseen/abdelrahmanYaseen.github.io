---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
---

<Base title="Not found" description="This page doesn't exist." locale="en">
  <Nav locale="en" />
  <main id="main" class="not-found">
    <svg class="not-found__mark" viewBox="0 0 18 18" aria-hidden="true">
      <polygon points="9,1 17,9 9,17 1,9" fill="none" stroke="currentColor" stroke-width="0.75"/>
      <circle cx="9" cy="9" r="2" fill="currentColor"/>
    </svg>
    <h1 class="not-found__title">404</h1>
    <p class="not-found__sub">This visualization doesn't exist — yet.</p>
    <a href="/en/" class="not-found__link">← Return home</a>
  </main>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-block-size: 60vh;
    text-align: center;
    padding-inline: var(--space-6);
    gap: var(--space-4);
  }

  .not-found__mark {
    inline-size: 4rem;
    block-size: 4rem;
    color: var(--accent);
  }

  .not-found__title {
    font-family: var(--font-mono);
    font-size: 4rem;
    font-weight: 400;
    color: var(--text-faint);
    line-height: 1;
  }

  .not-found__sub {
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .not-found__link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
    text-decoration: none;
    border: 1px solid var(--border-hairline);
    padding-block: var(--space-2);
    padding-inline: var(--space-4);
    border-radius: var(--radius-sm);
    margin-block-start: var(--space-4);
    transition: border-color var(--duration-fast);
  }

  .not-found__link:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
</style>
