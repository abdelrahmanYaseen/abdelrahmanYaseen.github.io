---
import type { ArtifactManifest } from "../types/manifest";
import type { Locale } from "../lib/i18n";
import { t } from "../lib/i18n";
import ArtifactCard from "./ArtifactCard.astro";

interface Props {
  related: ArtifactManifest[];
  locale: Locale;
}

const { related, locale } = Astro.props;
---

{
  related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading" class="related__heading">
        {t(locale, "artifact.related")}
      </h2>
      <div class="related__grid">
        {related.map((manifest) => (
          <ArtifactCard manifest={manifest} locale={locale} />
        ))}
      </div>
    </section>
  )
}

<style>
  .related {
    margin-block-start: var(--space-16);
  }

  .related__heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--text-muted);
    margin-block-end: var(--space-6);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--border-hairline);
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }
</style>
