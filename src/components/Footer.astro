---
import type { Locale } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__logo">
      <svg class="mark-diamond" viewBox="0 0 18 18" aria-hidden="true" style="color:var(--text-faint)">
        <polygon points="9,1 17,9 9,17 1,9" fill="none" stroke="currentColor" stroke-width="0.75"/>
        <circle cx="9" cy="9" r="2" fill="currentColor"/>
      </svg>
    </div>
    <nav class="footer__links" aria-label="Footer navigation">
      <a href={`/${locale}/about`}>{t(locale, "footer.about")}</a>
      <a href={`/${locale}/about#methodology`}>{t(locale, "footer.methodology")}</a>
    </nav>
    <div class="footer__locale">
      <a
        href={locale === "en" ? "/ar/" : "/en/"}
        class="footer__lang-link"
        aria-label={t(locale, "footer.language")}
      >
        {locale === "en" ? "العربية" : "English"}
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-block-start: 1px solid var(--border-hairline);
    margin-block-start: var(--space-24);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-inline-size: 1200px;
    margin-inline: auto;
    padding-block: var(--space-8);
    padding-inline: var(--space-6);
  }

  .footer__links {
    display: flex;
    gap: var(--space-6);
    flex: 1;
  }

  .footer__links a {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--duration-fast) var(--easing-out);
  }

  .footer__links a:hover {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer__locale {
    margin-inline-start: auto;
  }

  .footer__lang-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    text-decoration: none;
    border: 1px solid var(--border-hairline);
    padding-block: var(--space-1);
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-fast), color var(--duration-fast);
  }

  .footer__lang-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
</style>
