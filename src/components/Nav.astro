---
import type { Locale } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath = "" } = Astro.props;

const navLinks = [
  { href: `/${locale}/explore`, label: t(locale, "nav.explore") },
  { href: `/${locale}/about`, label: t(locale, "nav.about") },
];
---

<header class="nav">
  <div class="nav__inner">
    <a href={`/${locale}/`} class="nav__logo" aria-label={t(locale, "meta.siteName")}>
      <svg class="mark-diamond" viewBox="0 0 18 18" aria-hidden="true">
        <polygon
          points="9,1 17,9 9,17 1,9"
          fill="none"
          stroke="currentColor"
          stroke-width="0.75"
        />
        <circle cx="9" cy="9" r="2" fill="currentColor" />
      </svg>
      <span class="nav__wordmark">howdoesitlooklike</span>
    </a>

    <nav class="nav__links" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={["nav__link", { "nav__link--active": currentPath.startsWith(link.href) }]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: var(--bg-page);
    border-block-end: 1px solid var(--border-hairline);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-inline-size: 1200px;
    margin-inline: auto;
    padding-block: var(--space-4);
    padding-inline: var(--space-6);
    gap: var(--space-6);
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
  }

  .nav__logo:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .nav__logo .mark-diamond {
    color: var(--accent);
    flex-shrink: 0;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav__link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--easing-out);
  }

  .nav__link:hover,
  .nav__link--active {
    color: var(--accent);
    text-decoration: none;
  }
</style>
